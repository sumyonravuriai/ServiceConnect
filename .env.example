# =============================================================================
# ServiceConnect - Production Environment Configuration Template
# Copy this file to .env or set these environment variables on your production host
# =============================================================================

# 1. DATABASE CONFIGURATION (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/serviceconnect_db?useSSL=true&allowPublicKeyRetrieval=false&serverTimezone=UTC
DB_USERNAME=serviceconnect_prod_user
DB_PASSWORD=YourStrongDatabasePasswordHere123!

# 2. APPLICATION RUNTIME & URLS
PORT=8080
APP_BASE_URL=https://serviceconnect-web.vercel.app
FRONTEND_URL=https://serviceconnect-web.vercel.app

# 3. SECURITY & JWT (HMAC-SHA256)
# Generate a cryptographically secure 256-bit+ random secret
JWT_SECRET=Your64CharacterOrLongerHexRandomSecretKeyServiceConnect2026!
JWT_EXPIRATION_MS=86400000

# 4. TRANSACTIONAL EMAIL VIA HTTPS PORT 443 (Recommended for Render, AWS, Cloud PaaS)
# Free 3,000 emails/month from https://resend.com (No domain required to start, uses onboarding@resend.dev)
RESEND_API_KEY=re_123456789abcdef
# OR Free 300 emails/day from https://brevo.com
BREVO_API_KEY=xkeysib-123456789abcdef

# Sender & Verification Address
MAIL_FROM=onboarding@resend.dev

# 5. LEGACY SMTP CONFIGURATION (Note: Render blocks outbound ports 25, 465, and 587 by default)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
